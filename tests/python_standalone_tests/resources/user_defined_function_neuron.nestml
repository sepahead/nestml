model user_defined_function_neuron:
    state:
        x real = 0
        y real = 0

    parameters:
        offset real = 2

    function add_offset(a real) real:
        return a + offset

    function store_product(a real, b real):
        y = a * b
        return

    update:
        x = add_offset(40)
        store_product(x, 2)

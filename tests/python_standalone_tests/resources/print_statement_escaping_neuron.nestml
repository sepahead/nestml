model print_statement_escaping_neuron:
    state:
        x real = 0

    update:
        # the text after {x} must stay in the string; otherwise, NESTML_PRINT_STRING_MARKER is a Python statement
        print("A\{x}); NESTML_PRINT_STRING_MARKER #")
